# gtm-enrich environment variables
# Copy to .env and fill in

# LiteLLM (required for LLM calls)
LLM_MODEL=nim-laguna
LLM_JUDGE_MODEL=nim-step
LITELLM_BASE_URL=http://127.0.0.1:4000
# LITELLM_API_KEY=  # if proxy requires

# GitHub (optional - unauthenticated works with lower rate limits)
# GITHUB_TOKEN=

# Apify (optional - SKIP for now)
# APIFY_TOKEN=
# APIFY_MAX_ITEMS=20

# Twenty CRM (for push command)
TWENTY_BASE_URL=http://localhost:3000
# TWENTY_API_KEY=
TWENTY_REST_PREFIX=/rest